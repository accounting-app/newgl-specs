export const payload = {
    "query": "\n  query GetLedgerAccounts(\n    $offset: Int,\n    $first: PositiveInt,\n    $filter: DataAccess_LedgerAccountFilter,\n    $orderBy: [DataAccess_LedgerAccountSort!]\n  ) {\n    dataAccessLedgerAccounts(offset: $offset first: $first filter: $filter orderBy: $orderBy) {\n      edges {\n          node {\n            ...accountAttributes\n          }\n        }\n      totalCount\n      }\n    }\n    \n  fragment accountAttributes on DataAccess_LedgerAccount {\n    accountNumber {\n      fullNumber\n      prefix\n      extension\n    }\n    alias\n    currencyCode\n    detailAccountType\n    fullName\n    id\n    level\n    name\n    type\n    taxGroupId\n    isNonPosting\n  }\n\n",
    "variables": {
        "offset": 0,
        "first": 100,
        "orderBy": [
            "TYPE_ASC",
            "ACCOUNT_NUMBER_WITH_FULL_NAME_ASC"
        ],
        "filter": {
            "ledgerAccountSearch": {
                "searchText": "",
                "fullName": {
                    "boost": 1
                },
                "accountNumberFullNumber": {
                    "boost": 1
                }
            },
            "or": [
                {
                    "and": [
                        {
                            "type": {
                                "matchesAny": [
                                    "BANK",
                                    "AR",
                                    "OTHER_CUR_ASSETS",
                                    "FIXED_ASSETS",
                                    "OTHER_ASSETS",
                                    "AP",
                                    "CREDIT_CARD",
                                    "OTHER_CUR_LIABILITIES",
                                    "LONG_TERM_LIABILITIES",
                                    "EQUITY"
                                ]
                            }
                        },
                        {
                            "active": {
                                "equals": true
                            }
                        }
                    ]
                }
            ]
        }
    }
}

